# Used by docker compose. Copy to .env and fill the gateway and panel settings.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ROUTER_SECRET_KEY=
ADMIN_API_KEY=

# Google OAuth for the panel. Register AUTH_URL/api/auth/callback/google.
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
PANEL_ALLOWED_EMAILS=rarevalo0306@gmail.com

# Optional public SDK base URL including /v1. The panel serves /v1 by default.
PUBLIC_API_BASE_URL=
