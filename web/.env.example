# Server-side only. Do not prefix with NEXT_PUBLIC.
API_INTERNAL_URL=http://127.0.0.1:8000
# Optional public SDK base URL, including /v1. Defaults to the panel origin + /v1.
PUBLIC_API_BASE_URL=
ADMIN_API_KEY=

# Google sign-in for the panel. Create the OAuth client in Google Cloud.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Production redirect URI: https://router.jokma.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
PANEL_ALLOWED_EMAILS=rarevalo0306@gmail.com
